#cloud-config
# WORKSHOP ONLY: the desktop edition's first boot (desktop design §3). make-vm.ps1 replaces
# @PASSWORD@ and packs this into seed.iso; the seed is never committed.
hostname: ai-os
users:
  - name: ai
    uid: "1000"
    shell: /bin/bash
    lock_passwd: false
chpasswd:
  expire: false
  users:
    - name: ai
      password: "@PASSWORD@"
      type: text
ssh_pwauth: false
package_update: true
packages:
  - virtualbox-guest-utils
  - btrfs-progs
runcmd:
  - mkdir -p /mnt/repo
  - echo 'repo /mnt/repo vboxsf uid=1000,gid=1000,nofail 0 0' >> /etc/fstab
  # The share is not mountable the moment cloud-init arrives here: apt has just touched
  # virtualbox-guest-utils and the guest additions are still restarting, so the first mount is
  # refused (first build, 2026-09-18 — it mounted on the next boot with no other change). It comes
  # up within a few seconds of a retry. The message goes to the setup log, which ai can read;
  # cloud-init's own log is root-only and a VM with no sudo cannot show it.
  - |
    modprobe vboxguest || true
    modprobe vboxsf || true
    systemctl daemon-reload
    i=0
    while [ $i -lt 20 ] && ! mountpoint -q /mnt/repo; do
      mount /mnt/repo || sleep 5
      i=$((i + 1))
    done
    mountpoint -q /mnt/repo || echo 'the repo share never mounted' | tee /var/log/ai-os-setup.log
  - [bash, -c, "set -o pipefail; bash /mnt/repo/trial/vm/setup-vm.sh 2>&1 | tee -a /var/log/ai-os-setup.log && reboot"]
