#cloud-config
# WORKSHOP ONLY: the desktop edition's first boot (desktop design §3). make-vm.ps1 replaces
# @PASSWORD@ and packs this into seed.iso; the seed is never committed.
hostname: ai-os
users:
  - name: ai
    uid: "1000"
    shell: /bin/bash
    lock_passwd: false
chpasswd:
  expire: false
  users:
    - name: ai
      password: "@PASSWORD@"
      type: text
ssh_pwauth: false
package_update: true
packages:
  - virtualbox-guest-utils
  - btrfs-progs
# The repo share cannot be mounted on the boot cloud-init runs in: twenty tries over a hundred
# seconds were all refused, while the very next boot mounted the same fstab line with nothing else
# changed (first and second builds, 2026-09-18). So this boot only lays the ground and reboots, and
# the unit below does the work on the boot that can see the share, then takes itself out.
write_files:
  - path: /etc/systemd/system/ai-os-setup.service
    permissions: '0644'
    content: |
      # WORKSHOP ONLY: runs the desktop edition's setup once, on the first boot after cloud-init.
      [Unit]
      Description=AI OS desktop edition setup
      Requires=mnt-repo.mount
      After=mnt-repo.mount network-online.target
      Wants=network-online.target
      ConditionPathExists=/mnt/repo/trial/vm/setup-vm.sh

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      TimeoutStartSec=infinity
      ExecStart=/bin/bash -c 'set -o pipefail; bash /mnt/repo/trial/vm/setup-vm.sh 2>&1 | tee -a /var/log/ai-os-setup.log'
      ExecStartPost=/bin/sh -c 'systemctl disable ai-os-setup.service; systemctl reboot'

      [Install]
      WantedBy=multi-user.target
runcmd:
  - mkdir -p /mnt/repo
  - echo 'repo /mnt/repo vboxsf uid=1000,gid=1000,nofail 0 0' >> /etc/fstab
  - systemctl daemon-reload
  - systemctl enable ai-os-setup.service
power_state:
  mode: reboot
  message: rebooting into the boot that can mount the repo share
  condition: true
